DATABASE_URL=postgresql+asyncpg://xui:xui@db:5432/xui_monitor
POLL_INTERVAL_SECONDS=60
ONLINE_POLL_SECONDS=30
TZ=Asia/Tehran
RAW_RETENTION_DAYS=14
HOURLY_RETENTION_DAYS=400
ALLOW_WRITE_ACTIONS=false

ADMIN_USERNAME=admin
# Prefer ADMIN_PASSWORD_HASH (argon2). For bootstrap only:
ADMIN_PASSWORD=changeme
JWT_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=24

# Optional read-only viewer
# VIEWER_USERNAME=viewer
# VIEWER_PASSWORD=viewerpass

# JSON array of panels. Use an admin-scope API token (monitor scope is NOT enough).
XUI_SERVERS=[]
# Or mount servers.yaml and set:
# SERVERS_YAML=/config/servers.yaml
